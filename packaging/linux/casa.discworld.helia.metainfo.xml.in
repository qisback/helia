<component type="desktop-application">
  <id>casa.discworld.helia</id>
  <name>Helia</name>
  <summary>Stack video of the Sun into one sharp image</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="casa.discworld">
    <name>Laurence Horrocks-Barlow</name>
  </developer>
  <description>
    <p>
      Helia is a lucky-imaging stacker for solar astrophotography. It reads SER,
      AVI and (with ffmpeg) MP4 captures of the Sun, scores every frame, aligns
      the best of them on the whole disc and stacks them into one sharp image,
      then sharpens, adjusts and colours the result.
    </p>
    <p>
      The desktop app guides you through the steps one at a time. The same engine
      is available from the command line (helia) and as a local API.
    </p>
    <p>
      Helia is dedicated to the author's daughter, the light of his life.
    </p>
  </description>
  <launchable type="desktop-id">helia.desktop</launchable>
  <provides>
    <binary>helia</binary>
    <binary>helia-gui</binary>
    <mediatype>video/x-astro-ser</mediatype>
  </provides>
  <categories>
    <category>Science</category>
    <category>Astronomy</category>
  </categories>
  <keywords>
    <keyword>sun</keyword>
    <keyword>solar</keyword>
    <keyword>astrophotography</keyword>
    <keyword>stacking</keyword>
  </keywords>
  <url type="homepage">https://github.com/qisback/helia</url>
  <url type="bugtracker">https://github.com/qisback/helia/issues</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
