# Build image for the native arm64 Linux release: Ubuntu 22.04 keeps the glibc 2.35 baseline,
# the same as the x86_64 job. Only the C toolchain; Rust comes from packaging/setup-rust.sh.
FROM ubuntu:22.04
RUN apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -yq --no-install-recommends \
      build-essential pkg-config curl ca-certificates git file binutils python3 \
    && rm -rf /var/lib/apt/lists/*
