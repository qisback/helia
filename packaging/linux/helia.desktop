[Desktop Entry]
Type=Application
Name=Helia
GenericName=Solar lucky-imaging stacker
Comment=Stack video of the Sun into one sharp image
Exec=helia-gui %F
Icon=helia
Terminal=false
Categories=Science;Astronomy;
Keywords=sun;solar;stacking;lucky imaging;astrophotography;
MimeType=video/x-astro-ser;video/x-msvideo;image/fits;
StartupWMClass=helia
StartupNotify=true
